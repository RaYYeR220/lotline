{
  "name": "lotline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "conformance:wm": "tsx scripts/conformance.ts world-model",
    "conformance:scout": "tsx scripts/conformance-scout.ts",
    "conformance:hmem": "tsx scripts/conformance-hmem.ts",
    "conformance:markovian": "tsx scripts/conformance-markovian.ts",
    "start": "tsx apps/api/src/main.ts",
    "trace": "tsx run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@lotline/core": "workspace:*",
    "@lotline/agents": "workspace:*"
  }
}
