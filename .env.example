# Run without Zetaris or Nightshift: real orchestration over the bundled snapshot.
SAMPLE_MODE=false

# Zetaris (data layer). REST API of a local or cloud Zetaris instance.
ZETARIS_BASE_URL=http://localhost:8888/api/v1.0
ZETARIS_API_TOKEN=
ZETARIS_ORG_ID=

# Meterless Nightshift (model provider). Token: %LOCALAPPDATA%\ai.meterless.runtime\proxy-token
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_TOKEN=

# Model pinned per lane (served through Nightshift).
LANE_REASON=nvidia/nemotron-3.5-lightning-30b-a3b
LANE_FAST=nvidia/nemotron-3.5-bolt-e4b
LANE_VISION=meterless/vision
LANE_GUARD=nvidia/nemotron-3.5-bolt-e4b
LANE_JUDGE=nvidia/nemotron-3-ultra-550b-a55b

# HMAC secret for Scout execution contracts.
CONTRACT_SECRET=change-me

LOGS_DIR=logs
